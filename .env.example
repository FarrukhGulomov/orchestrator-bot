# =============================================================================
# Senior Business Analyst AI Orchestrator — Environment Variables
# Only Claude (Anthropic) is required. No other AI provider keys needed.
# =============================================================================

# --- Required ----------------------------------------------------------------
BOT_TOKEN=123456:your-telegram-bot-token-from-BotFather

# --- AI Provider (choose ONE) ------------------------------------------------
#
# OPTION 1 — OpenRouter (RECOMMENDED: free, no credit card needed)
# Sign up at openrouter.ai → Keys → Create Key
# Free tier: 50 req/day per model, 20 req/min
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_REFERER=https://github.com/farrukhgulomov/orchestrator-bot
OPENROUTER_TITLE=BA Orchestrator Bot

# Free models (change if a model stops being free — check openrouter.ai/models):
OR_MAIN_MODEL=meta-llama/llama-4-maverick:free
OR_MAIN_MODEL_LABEL=Llama 4 Maverick (free)
OR_FAST_MODEL=meta-llama/llama-4-scout:free
OR_FAST_MODEL_LABEL=Llama 4 Scout (free)

#
# OPTION 2 — Claude / Anthropic (paid, higher quality)
# Leave blank if using OpenRouter above.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_LABEL=Claude Sonnet 4.6
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001
CLAUDE_FAST_MODEL_LABEL=Claude Haiku 4.5

# Max tokens per agent reply. Increase if long documents get cut off.
MAX_OUTPUT_TOKENS=8192

# --- Access control ----------------------------------------------------------
# Comma-separated Telegram chat IDs the bot is allowed to serve.
# Leave EMPTY to allow all chats. Send /id in a chat to get its chat_id.
ALLOWED_CHAT_IDS=

# In groups: only respond when @mentioned or replied to.
REQUIRE_MENTION_IN_GROUPS=true

# Proactive group mode: bot reads ALL group messages and joins in when the topic
# is relevant (business, data, tech, etc.) — even without @mention.
# Set PROACTIVE_IN_GROUPS=true to enable. Works alongside REQUIRE_MENTION_IN_GROUPS.
# Cooldown (seconds) prevents the bot from responding more than once per interval.
PROACTIVE_IN_GROUPS=false
PROACTIVE_COOLDOWN_SECONDS=45

# Show agent/model metadata header in replies? Default false (clean replies).
# Set true while debugging routing.
SHOW_METADATA_HEADER=false

# --- Behaviour ---------------------------------------------------------------
HISTORY_TURNS=10
REQUEST_TIMEOUT=90
MAX_FILE_SIZE_MB=20

# --- Persistent storage (strongly recommended) --------------------------------
# Without this, conversation history and project memory are in-memory only
# and will be lost on every restart/redeploy (Railway redeploys on git push).
#
# To enable on Railway:
#   1. Project → + New → Database → Add Redis
#   2. On this bot service, add: REDIS_URL = ${{Redis.REDIS_URL}}
#
# Leave empty for in-memory-only mode (dev/testing).
REDIS_URL=
REDIS_HISTORY_TTL_SECONDS=2592000

# --- Optional: GitHub integration (requirements/tasks → tracked issues) ------
# Leave GITHUB_TOKEN or GITHUB_REPO empty to disable.
# Token needs: Issues + Contents + Pull requests permissions.
# NEVER commit this token — only set it here in .env.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_DEFAULT_BRANCH=main
# If true, code tickets with file-marked blocks also open a draft PR.
GITHUB_AUTO_PR=false

# --- Optional: Railway integration (read-only deployment logs) ---------------
# Lets the Tech Consultant analyse real server logs via /logs command.
# Get token: Railway → Account Settings → Tokens.
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
