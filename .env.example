# --- Credentials (required) ------------------------------------------------
BOT_TOKEN=123456:your-telegram-bot-token-from-BotFather
GEMINI_API_KEY=your-google-ai-studio-key
GROQ_API_KEY=your-groq-cloud-key

# --- Access control --------------------------------------------------------
# Comma-separated chat IDs the bot is allowed to serve. Leave EMPTY to allow all.
# Send /id in a chat to learn its chat_id.
ALLOWED_CHAT_IDS=

# In groups, only respond when @mentioned or replied to. "false" = always answer.
REQUIRE_MENTION_IN_GROUPS=true

# Output header format:
#   x_metadata (default) — **[X_ORCHESTRATOR_METADATA]** block with
#                           CLASSIFICATION / ASSIGNED_AGENT / ROUTED_MODEL
#   simple                — compact [ACTIVE_AGENT]/[ROUTED_MODEL] lines
METADATA_FORMAT=x_metadata
# Show the metadata header to users at all? Default false — replies read
# like they came from a person, not a visibly multi-agent system. Routing
# info still goes to logs regardless. Set true while debugging routing.
SHOW_METADATA_HEADER=false

# --- Voice replies: voice note in -> voice note out -------------------------
# Uses Gemini's native TTS. Strong coverage for English/Russian; Uzbek is NOT
# explicitly confirmed in Google's published language list — test with your
# team's real usage. Set false to fall back to a text reply for voice notes.
VOICE_REPLIES_ENABLED=true
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Kore
# Languages where Gemini TTS produces the WRONG language entirely (confirmed
# by real testing: Uzbek text -> Kazakh audio, even with an explicit language
# hint). For any code listed here, voice replies send TEXT instead of risking
# wrong-language audio. Comma-separated uz/ru/en codes.
TTS_UNSUPPORTED_LANGUAGES=uz

# --- Models (Route A: Gemini, Route B: Groq fast, Route C: GLM-5.2) -------
# ROUTE A — analysis / docs (Gemini). NOTE: Gemini 1.5 Flash is shut down.
ANALYSIS_MODEL=gemini-3.5-flash
ANALYSIS_MODEL_LABEL=Gemini 3.5 Flash

# ROUTE B — fast, simple code tasks (Groq / Llama 8B, low latency).
# NOTE: llama-3.1-8b-instant deprecated 2026-06-17; may need migration.
CODE_MODEL_FAST=llama-3.1-8b-instant
CODE_MODEL_FAST_LABEL=Llama 3.1 8B (Groq)

# ROUTE C — complex coding, architecture, refactoring (GLM via Z.AI or Together AI).
# Falls back to Route B (Groq) if GLM_API_KEY is not set OR if the health-check
# at startup returns 404 (wrong model for your plan). Bot logs the exact fix.
#
# PICK ONE option:
#
# Option A — Z.AI Coding Plan ($18/month, glm-5.2 access):
#   GLM_API_KEY = <your Z.AI key from z.ai/manage-apikey/apikey-list>
#   GLM_MODEL = glm-5.2
#   GLM_BASE_URL = https://api.z.ai/api/coding/paas/v4/   ← must use Coding Plan endpoint
#   GLM_MODEL_LABEL = GLM-5.2 (Z.AI Coding Plan)
#
# Option B — Together AI (pay-per-token, no subscription, glm-5.2 access):
#   GLM_API_KEY = <your Together AI key from api.together.xyz>
#   GLM_MODEL = zai-org/GLM-5.2
#   GLM_BASE_URL = https://api.together.xyz/v1/
#   GLM_MODEL_LABEL = GLM-5.2 (Together AI)
#
# Option C — Z.AI free tier (older GLM-4.7, no subscription needed):
#   GLM_API_KEY = <your Z.AI key from z.ai/manage-apikey/apikey-list>
#   GLM_MODEL = glm-4.7           (or glm-4.7-flash for the free tier)
#   GLM_BASE_URL = https://api.z.ai/api/paas/v4/   ← general endpoint (default)
#   GLM_MODEL_LABEL = GLM-4.7 (Z.AI)
#
# Current defaults below = Option C (free, glm-4.7, general endpoint):
GLM_API_KEY=
GLM_MODEL=glm-4.7
GLM_BASE_URL=https://api.z.ai/api/paas/v4/
GLM_MODEL_LABEL=GLM-4.7 (Z.AI)

# Router classifier model (Groq, used for the fast classify() call).
ROUTER_MODEL=llama-3.1-8b-instant

# Audio transcription (voice notes / mp3 / wav / etc.) via Groq Whisper.
WHISPER_MODEL=whisper-large-v3-turbo

# Reject inbound files larger than this many MB (download fails fast with a
# clear message instead of hanging).
MAX_FILE_SIZE_MB=20

# Max tokens per agent reply. Increase if longer deliverables (full code
# files, full design specs) still get cut off mid-sentence.
MAX_OUTPUT_TOKENS=8192

# --- Behaviour -------------------------------------------------------------
HISTORY_TURNS=8
REQUEST_TIMEOUT=60

# --- Persistent storage (recommended) ---------------------------------------
# Without this, conversation history AND project memory live only in this
# process's RAM — wiped on every restart/redeploy (Railway redeploys on every
# git push). To persist across deploys:
#   1. In your Railway project: + New -> Database -> Add Redis
#      (or Cmd/Ctrl+K -> type "Redis")
#   2. On THIS bot service, add a variable:
#        REDIS_URL = ${{Redis.REDIS_URL}}
#      (Railway's reference-variable syntax — auto-fills the real connection
#      string from the Redis service, no copy-pasting secrets around)
# Leave empty to keep the current in-memory-only behaviour.
REDIS_URL=
# How long inactive chat HISTORY is kept before Redis expires it (seconds).
# Project MEMORY facts have no TTL — durable until /forget.
REDIS_HISTORY_TTL_SECONDS=2592000

# --- Optional: Railway integration (real /logs, read-only) ------------------
# Lets DevOps/SOC/Tech Lead analyze REAL deployment status + runtime logs
# from this bot's own Railway service instead of guessing. Deliberately
# read-only — no deploy-trigger command (see railway_integration.py docstring
# for why). Get a token: Railway -> Account Settings -> Tokens. NEVER share
# this in chat. Project/Environment/Service ID are usually already present
# in this bot's own environment (Railway auto-injects them) — only the
# token typically needs to be added manually.
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=

# --- Optional: GitHub integration (idea/task/bug/improve -> tracked work) ---
# Leave GITHUB_TOKEN or GITHUB_REPO empty to disable this feature entirely.
# Token needs "repo" scope (classic) or Issues+Contents+Pull requests (fine-grained).
# NEVER share this token in chat or commit it — only set it here, in .env on
# your own server. This file is already gitignored.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_DEFAULT_BRANCH=main
# If true, actionable code tickets that contain file-marked code blocks also
# open a DRAFT pull request with the AI-generated implementation. Always
# review AI-written PRs before merging — keep this "false" until you trust it.
GITHUB_AUTO_PR=false
