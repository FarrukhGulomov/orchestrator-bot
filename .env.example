# =============================================================================
# Senior Business Analyst AI Orchestrator — Environment Variables
# =============================================================================

# --- Required ----------------------------------------------------------------
BOT_TOKEN=123456:your-telegram-bot-token-from-BotFather

# --- AI Provider -------------------------------------------------------------
#
# OPTION 1 — OpenRouter only (bepul, kredit karta shart emas)
# openrouter.ai → Keys → Create Key
# Bepul: 50 req/day per model, 20 req/min
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_REFERER=https://github.com/farrukhgulomov/orchestrator-bot
OPENROUTER_TITLE=BA Orchestrator Bot

# Bepul modellar (openrouter.ai/models dan yangilarini tekshiring):
OR_MAIN_MODEL=meta-llama/llama-4-maverick:free
OR_MAIN_MODEL_LABEL=Llama 4 Maverick (free)
# HYBRID rejimida shu model oddiy/past murakkablikdagi savollarga ham javob
# beradi (Claude tokenini tejash uchun). Default — OpenRouter'ning o'zining
# "openrouter/free" routeri: har doim HOZIR ishlab turgan bepul modellardan
# birini avtomatik tanlaydi. Muayyan modelni "google/gemini-...:free" kabi
# qattiq belgilash TAVSIYA ETILMAYDI — provayderlar bepul modellarni
# ogohlantirishsiz to'xtatib qo'yishi mumkin (aynan shu sabab tufayli bot
# xato bera boshlagan edi). Aniq bir modelni xohlasangiz, openrouter.ai/models
# dan ":free" bilan tugaydigan joriy modelni tanlab shu yerga yozing.
OR_FAST_MODEL=openrouter/free
OR_FAST_MODEL_LABEL=OpenRouter Free Router

#
# OPTION 2 — Claude / Anthropic only (yuqori sifat, pullik)
ANTHROPIC_API_KEY=sk-ant-your-claude-key
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_LABEL=Claude Sonnet 4.6
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001
CLAUDE_FAST_MODEL_LABEL=Claude Haiku 4.5

#
# OPTION 3 — HYBRID / avtomatik failover (TAVSIYA ETILADI)
# Nechta kalit yozsangiz, shuncha provayder ishlaydi — barcha suhbat
# javoblari doim ENG KUCHLI sozlangan model bilan javob beradi; biror
# provayderning kaliti ishlamay qolsa (noto'g'ri/limit tugagan/xizmat
# ishlamayapti), navbatdagi provayder avtomatik javob beradi. Tartibni
# PROVIDER_PRIORITY bilan o'zgartirish mumkin. Routing/tez ichki
# chaqiruvlar har bir provayderning tez/arzon modelidan foydalanadi.
# Vision/PDF hozircha faqat Claude yoki OpenRouter orqali ishlaydi.
#
# OPTION 4 — Qo'shimcha provayderlar (barchasi ixtiyoriy, failover zanjiriga qo'shiladi)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
XAI_API_KEY=
GROK_MODEL=grok-4
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
KIMI_API_KEY=
KIMI_MODEL=kimi-k2-0711-preview
# Failover tartibi — faqat kaliti bor provayderlar ishlatiladi:
PROVIDER_PRIORITY=openai,claude,gemini,grok,deepseek,kimi,openrouter

# Max tokens per agent reply. Increase if long documents get cut off.
MAX_OUTPUT_TOKENS=8192

# --- Optional: live web search (STRONGLY RECOMMENDED) -------------------------
# Without this the bot answers time-sensitive questions (kurs, ob-havo,
# yangiliklar, raqiblar narxi, "eng yangi versiya") from its training data —
# i.e. confidently out of date. With it, the router detects such questions
# automatically and grounds the answer in live sources; /search also works
# manually. tavily.com → bepul kalit (oyiga 1000 so'rov, karta shart emas).
TAVILY_API_KEY=

# --- Optional: voice message transcription ------------------------------------
# Without this, voice messages get a friendly "not available yet" reply
# instead of a transcript. groq.com → API Keys → Create key (bepul, kredit
# karta shart emas — 2000 so'rov/kun). Whisper avtomatik tilni aniqlaydi
# (o'zbek, rus, ingliz — barchasi ishlaydi, alohida sozlash shart emas).
GROQ_API_KEY=

# --- Optional: meeting attendee (browser automation) ---------------------------
# /uchrashuv <link> — bot Google Meet/Zoom/Teams'ga guest sifatida qo'shiladi,
# qo'shilgach uchrashuv chatiga OCHIQ e'lon yozadi ("bu qo'ng'iroq yozib
# olinmoqda"), keyin audio yozib oladi va /minutes bilan bir xil protokolni
# avtomatik tayyorlaydi. E'lon MAJBURIY va o'chirib bo'lmaydi — agar chatga
# yoza olmasa, bot yozib olishni umuman BOSHLAMAYDI. Batafsil: meeting_attendee.py.
#
# Default: o'chirilgan. `playwright` python paketi requirements.txt ichida
# (har doim o'rnatiladi, kichkina), Chromium brauzer esa BIRINCHI /uchrashuv
# chaqirilganda o'zi avtomatik yuklanadi (meeting_attendee._ensure_chromium)
# — qo'lda `playwright install` shart emas.
#
# Faqat bitta narsa hali ham QO'LDA kerak: ffmpeg + PulseAudio + Chromium'ning
# tizim kutubxonalari (Debian: libnss3, libatk-bridge2.0-0, libgbm1, ...) —
# bular root+apt bilan FAQAT deploy vaqtida o'rnatiladi, bot runtime'da o'zi
# o'rnata olmaydi. Bu repoda buning uchun hech qanday env var kerak emas —
# `Dockerfile` o'zi shularni o'rnatadi, va Railway repo tagida Dockerfile
# borligini ko'rgach nixpacks o'rniga aynan o'shani ishlatadi (Railway'ning
# o'z qoidasi). Shunchaki qayta deploy qiling — Dockerfile yangilangan.
MEETING_BOT_ENABLED=false
MEETING_BOT_DISPLAY_NAME=BA Orchestrator — Recording Bot
# Ixtiyoriy — e'londa tashkilot nomini ko'rsatish uchun.
MEETING_BOT_ORG_NAME=
# Xavfsizlik chegarasi: /uchrashuvtugat unutilsa ham abadiy yozmasin.
MEETING_MAX_DURATION_MINUTES=180
MEETING_AUDIO_DIR=/tmp/meeting_audio
MEETING_BOT_HEADLESS=false

# --- Access control ----------------------------------------------------------
# Comma-separated Telegram chat IDs the bot is allowed to serve.
# Leave EMPTY to allow all chats. Send /id in a chat to get its chat_id.
ALLOWED_CHAT_IDS=

# --- Admin approval gate (PRIVATE chats only) ---------------------------------
# A new private-chat user cannot use the bot until you approve them. They're
# told to contact ADMIN_USERNAME, and their message is forwarded to you with
# Approve/Reject buttons — reply directly to that forwarded message (Telegram's
# native "Reply") to have your answer relayed straight back to them.
#
# Set your Telegram @username here (no @, case-insensitive) — this alone is
# enough to get started:
ADMIN_USERNAME=Farruh
# Recommended once you know it: your numeric Telegram user ID (send /id to the
# bot after ADMIN_USERNAME above has let you in once) — more robust than the
# username match since it survives you changing your @username later.
ADMIN_USER_ID=

# In groups: only respond when @mentioned or replied to.
REQUIRE_MENTION_IN_GROUPS=true

# Proactive group mode: bot reads ALL group messages and joins in when the topic
# is relevant (business, data, tech, etc.) — even without @mention.
# Set PROACTIVE_IN_GROUPS=true to enable. Works alongside REQUIRE_MENTION_IN_GROUPS.
# Cooldown (seconds) prevents the bot from responding more than once per interval.
PROACTIVE_IN_GROUPS=false
PROACTIVE_COOLDOWN_SECONDS=45

# Group mention copilot: add the bot as a PLAIN MEMBER (no admin rights
# needed) to any group. If someone @mentions YOU (the admin) there, or
# replies to a message YOU sent in that group, the bot AI-analyzes it and
# privately sends YOU (in your own DM with the bot) an analysis + a ready
# suggested reply — with buttons to send it into the group or ignore it.
# It never posts in the group on its own.
#
# REQUIRES: BotFather -> your bot -> /setprivacy -> Disable. Otherwise
# Telegram's default Privacy Mode only forwards messages that @mention or
# reply to the BOT itself — a message that only mentions YOU never reaches
# the bot at all, and this feature silently sees nothing.
WATCH_GROUP_MENTIONS=true

# Show agent/model metadata header in replies? Default false (clean replies).
# Set true while debugging routing.
SHOW_METADATA_HEADER=false

# --- Daily task reminders ------------------------------------------------------
# IANA timezone used to interpret "bugun soat 15:00", "ertaga" etc, and to
# display reminder times back to you.
TIMEZONE=Asia/Tashkent
# How often (seconds) the background loop checks for due reminders.
REMINDER_POLL_SECONDS=30

# --- Work-hours awareness (Business Copilot "ishdamisan?" answers) -----------
# When a Business-chat contact asks if you're at work, the suggested reply is
# grounded in these real hours instead of always claiming to be at work.
WORK_START_HOUR=9
WORK_END_HOUR=18
# Work days, Mon=0..Sun=6. Default Mon-Fri.
WORK_DAYS=0,1,2,3,4
# "MM-DD" repeats every year (fixed-date Uzbek national holidays below by
# default); "YYYY-MM-DD" matches once. Ro'za/Qurbon hayit shift yearly on
# the lunar calendar — add this year's exact dates manually as YYYY-MM-DD.
HOLIDAYS=01-01,03-08,03-21,05-09,09-01,12-08

# --- Behaviour ---------------------------------------------------------------
HISTORY_TURNS=10
REQUEST_TIMEOUT=90
MAX_FILE_SIZE_MB=20

# --- Persistent storage: PostgreSQL (STRONGLY RECOMMENDED — the durable
# source of truth for users/access-control, per-user profile notes, tasks/
# reminders, decision log, and project memory: see db.py). Without it, all
# of that lives in Redis if configured, or in-memory otherwise — wiped on
# every restart/redeploy (Railway redeploys on git push).
#
# To enable on Railway:
#   1. Project → + New → Database → Add PostgreSQL
#   2. On this bot service, add: DATABASE_URL = ${{Postgres.DATABASE_URL}}
# Tables are created automatically on startup. If REDIS_URL was already
# storing this data, it's copied over automatically, once, the first time
# DATABASE_URL becomes available — no manual export/import needed.
DATABASE_URL=

# --- Persistent storage: Redis (recommended alongside Postgres) --------------
# Used for short-lived session/UI state regardless of DATABASE_URL (relay
# mappings for the copilot "send"/"dismiss" buttons, rolling conversation
# history for AI context, the meeting-minutes batch stash) — these expire
# on purpose and don't belong in a relational database. Also serves as the
# fallback for the durable data above when DATABASE_URL isn't set.
#
# To enable on Railway:
#   1. Project → + New → Database → Add Redis
#   2. On this bot service, add: REDIS_URL = ${{Redis.REDIS_URL}}
#
# Leave both empty for fully in-memory mode (dev/testing only).
REDIS_URL=
REDIS_HISTORY_TTL_SECONDS=2592000

# --- Optional: GitHub integration (requirements/tasks → tracked issues) ------
# Leave GITHUB_TOKEN or GITHUB_REPO empty to disable.
# Token needs: Issues + Contents + Pull requests permissions.
# NEVER commit this token — only set it here in .env.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_DEFAULT_BRANCH=main
# If true, code tickets with file-marked blocks also open a draft PR.
GITHUB_AUTO_PR=false

# --- LLM telemetry & spend guardrails (see telemetry.py) ---------------------
# Records every AI call's cost/tokens/latency/provider. On by default — it's
# read-only bookkeeping, not enforcement. /xarajatai (admin) reports spend.
TELEMETRY_ENABLED=true
# Per-user daily token cap. 0 = disabled (default). The admin is NEVER
# capped. Set carefully: too low locks someone out of their own assistant.
DAILY_USER_TOKEN_BUDGET=0
# Optional: override the built-in cost-estimate table, e.g.
#   MODEL_PRICES_JSON={"gpt-4.1": [2.0, 8.0]}
# (USD per 1M tokens, as [input, output]). Estimates only — not billing data.
MODEL_PRICES_JSON=

# --- Optional: Railway integration (read-only deployment logs) ---------------
# Lets the Tech Consultant analyse real server logs via /logs command.
# Get token: Railway → Account Settings → Tokens.
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
